#!/usr/bin/env bash
# =============================================================================
#  spark — spark-stack yönetim komutu (her şey Docker)
#
#    spark up [demo|daily|fable|swap|canvas|a2a|extras|stt]  servisleri aç (varsayılan: daily)
#    spark down                          hepsini kapat
#    spark status                        ne çalışıyor, bellek, disk
#    spark swap                          llama-swap durumu: hangi katman ayakta
#    spark canvas                        Agent Canvas adresi ve panel anahtarı
#    spark a2a                           A2A köprüsü: kart ve roller
#    spark agents [--liste|--kurulu|--ekle|--sil|--onerilen]  uzman rolleri yönet
#    spark logs [servis]                 canlı log
#    spark pull <sonnet|opus|fable>      model ağırlığı indir (konteynerle)
#    spark models                        katman → model eşlemesi ve durum
#    spark ask "soru" [katman]           hızlı test (varsayılan opus)
#    spark update                        imajları güncelle
# =============================================================================
set -uo pipefail
AI_ROOT="${AI_ROOT:-/srv/ai}"
cd "$AI_ROOT/compose" 2>/dev/null || { echo "kurulum bulunamadı: $AI_ROOT/compose"; exit 1; }
set -a; [[ -f .env ]] && source .env; set +a
# Kullanıcı docker grubuna yeni eklendiyse bu oturumda sokete erişemez; sudo'ya düş.
if docker info >/dev/null 2>&1; then DKR="docker"
elif sudo -n docker info >/dev/null 2>&1; then DKR="sudo docker"
else
  echo "docker çalışmıyor. Yeni terminal aç ya da: sudo systemctl start docker"; exit 1
fi
DC="$DKR compose --env-file $AI_ROOT/compose/.env -f $AI_ROOT/compose/docker-compose.yml"

B=$'\033[1m'; D=$'\033[2m'; G=$'\033[1;32m'; R=$'\033[0m'

port_of() { case "$1" in haiku) echo 8002;; sonnet) echo 8000;; opus) echo 8888;; fable) echo 8001;; gateway) echo 4000;; swap) echo "${SWAP_PORT:-8081}";; esac; }
alive()   { curl -sf "http://127.0.0.1:$(port_of "$1")/${2:-v1/models}" >/dev/null 2>&1; }
swap_on()   { $DKR ps --filter name=sk-llamaswap --filter status=running -q 2>/dev/null | grep -q .; }
canvas_on() { $DKR ps --filter name=sk-canvas    --filter status=running -q 2>/dev/null | grep -q .; }
a2a_on()    { $DKR ps --filter name=sk-a2a       --filter status=running -q 2>/dev/null | grep -q .; }

# GB10'da "nvidia-smi --query-gpu=memory.*" çoğu sürümde "Not Supported" döner:
# bellek GPU'ya ayrılmış değil, CPU ile ortak. O durumda /proc/meminfo'ya düşeriz.
memread() {
  local out
  out="$(nvidia-smi --query-gpu=memory.used,memory.total --format=csv,noheader 2>/dev/null | head -1)"
  if [[ -n "$out" && "$out" != *"Not Supported"* && "$out" != *"[N/A]"* ]]; then
    echo "$out"; return
  fi
  awk '/^MemTotal:/{t=$2} /^MemAvailable:/{a=$2}
       END{ if(t>0) printf "%.1f / %.1f GiB (birleşik bellek)", (t-a)/1048576, t/1048576; else print "?" }' \
      /proc/meminfo 2>/dev/null || echo "?"
}

wait_ready() {  # wait_ready <katman> <saniye> [yol]
  local n=$1 to=${2:-1800} p=${3:-v1/models} t=0
  local rv="${n^^}_REPO"; [[ -n "${!rv:-}" ]] && echo "   $n = ${!rv}"
  while ! alive "$n" "$p"; do
    sleep 5; t=$((t+5))
    printf '\r  ⏳ %s açılıyor… %ss %s(ilk açılışta GPU çekirdekleri derlenir)%s' "$n" "$t" "$D" "$R"
    (( t >= to )) && { printf '\n  ✖ %s açılmadı — spark logs %s\n' "$n" "$n"; return 1; }
  done
  printf '\r\033[K  %s✓%s %s hazır (%ss)\n' "$G" "$R" "$n" "$t"
}

case "${1:-status}" in

  up)
    PROFILE="${2:-daily}"
    if [[ "$PROFILE" == "a2a" ]]; then
      $DC --profile a2a up -d || exit 1
      exec "$0" a2a
    fi
    if [[ "$PROFILE" == "canvas" ]]; then
      $DC --profile canvas up -d || exit 1
      echo ">> Agent Canvas açılıyor"
      exec "$0" canvas
    fi
    # llama-swap düzeni: konteynerler kapalı oluşturulur, açmayı llama-swap üstlenir
    if [[ "$PROFILE" == "swap" ]]; then
      echo ">> model konteynerleri oluşturuluyor (kapalı)"
      $DC --profile demo --profile daily --profile fable create >/dev/null 2>&1 || true
      echo ">> kapı + llama-swap açılıyor"
      $DC --profile swap up -d || exit 1
      wait_ready swap 180 health || exit 1
      curl -sf http://127.0.0.1:4000/health/liveliness >/dev/null 2>&1 \
        && echo "  ✓ kapı hazır" || echo "  ! kapı henüz hazır değil"
      exec "$0" swap
    fi
    # Bellek çakışmasını önle: fable ile daily aynı anda olamaz
    if [[ "$PROFILE" == "fable" ]]; then
      echo ">> haiku/sonnet/opus kapatılıyor (fable tüm belleği ister)"
      $DC --profile daily stop haiku sonnet opus >/dev/null 2>&1
    elif [[ "$PROFILE" == "daily" || "$PROFILE" == "demo" ]]; then
      echo ">> fable kapatılıyor"
      $DC --profile fable stop fable >/dev/null 2>&1
      [[ "$PROFILE" == "demo" ]] && $DC --profile daily stop opus >/dev/null 2>&1
    fi
    echo ">> $PROFILE açılıyor"
    $DC --profile "$PROFILE" up -d || exit 1
    case "$PROFILE" in
      demo)  wait_ready haiku; wait_ready sonnet ;;
      daily) wait_ready haiku; wait_ready sonnet; wait_ready opus ;;
      fable) wait_ready fable 3600 ;;
    esac
    wait_ready gateway 300 2>/dev/null || curl -sf http://127.0.0.1:4000/health/liveliness >/dev/null && echo "  ✓ kapı hazır"
    exec "$0" status
    ;;

  down)
    $DC --profile demo --profile daily --profile fable --profile swap --profile canvas --profile a2a --profile extras --profile stt down
    echo "kapatıldı"
    ;;

  swap)
    if ! swap_on; then
      echo "llama-swap çalışmıyor."
      echo "  kur:  bash install.sh --with-swap --resume"
      echo "  aç :  spark up swap"
      exit 1
    fi
    printf '\n  %sllama-swap%s  ·  katman istek anında açılır\n\n' "$B" "$R"
    OUT="$(curl -sf --max-time 10 "http://127.0.0.1:${SWAP_PORT:-8081}/running" 2>/dev/null || true)"
    if [[ -z "$OUT" ]]; then
      echo "  (llama-swap cevap vermedi — spark logs llamaswap)"
    elif ! echo "$OUT" | jq -e . >/dev/null 2>&1; then
      echo "$OUT" | sed 's/^/  /'
    else
      # Çıktı biçimi sürümle değişebiliyor; model adını nerede bulursa oradan al.
      NAMES="$(echo "$OUT" | jq -r '[.. | objects | (.model // .id // .name) | select(type=="string")] | unique | .[]' 2>/dev/null)"
      if [[ -n "$NAMES" ]]; then
        while IFS= read -r m; do printf '    %s✓%s %s\n' "$G" "$R" "$m"; done <<<"$NAMES"
      else
        echo "  şu an ayakta katman yok — ilk istekte açılacak"
      fi
    fi
    printf '\n  Bellek      : %s\n\n' "$(memread)"
    ;;

  canvas)
    CP="${CANVAS_PORT:-8300}"
    if ! canvas_on; then
      echo "Agent Canvas çalışmıyor."
      echo "  kur:  bash install.sh --with-canvas --resume"
      echo "  aç :  spark up canvas"
      exit 1
    fi
    printf '\n  %sAgent Canvas%s\n\n' "$B" "$R"
    printf '    adres          http://localhost:%s/canvas\n' "$CP"
    printf '    panel anahtarı %s\n' "${CANVAS_KEY:-(.env içinde CANVAS_KEY yok)}"
    printf '    projeler       %s  %s(ajan yalnız burayı görür)%s\n' "${CANVAS_PROJECTS:-?}" "$D" "$R"
    printf '\n  %sSettings → LLM%s  (bir kez elle girilir, env ile ayarlanamıyor)\n' "$B" "$R"
    printf '    Model     litellm_proxy/%s\n' "${CANVAS_MODEL:-opus}"
    printf '    Base URL  http://litellm:4000\n'
    printf '    API Key   %s\n' "${LITELLM_KEY:-sk-spark}"
    # Ayarı anlatmak yerine canlı okuyoruz; kurulum zaten tohumluyor.
    CS="$(curl -sf --max-time 10 "http://127.0.0.1:$CP/api/settings" \
          -H "X-Session-API-Key: ${CANVAS_KEY:-}" 2>/dev/null)"
    SUB="$(echo "$CS" | jq -r '[(.. | objects | select(has("enable_sub_agents")) | .enable_sub_agents)] | first // "?"' 2>/dev/null)"
    MDL="$(echo "$CS" | jq -r '[(.. | objects | select(has("model")) | .model)] | first // "?"' 2>/dev/null)"
    printf '\n  %sAyarlar%s  %s(canlı okundu)%s\n' "$B" "$R" "$D" "$R"
    if [[ "$SUB" == "true" ]]; then
      printf '    alt ajan devri  %sAÇIK%s\n' "$G" "$R"
    else
      printf '    alt ajan devri  %sKAPALI%s — roller görev alamaz\n' "$D" "$R"
      printf '                    aç: Settings → Agent → Sub-agents\n'
    fi
    printf '    model           %s\n' "$MDL"
    printf '\n  %sRoller%s  %s(Canvas her konuşmada kendiliğinden yükler)%s\n' "$B" "$R" "$D" "$R"
    for r in "$AI_ROOT/data/canvas/agents"/*.md; do
      [ -e "$r" ] || { printf '    %s(kurulu değil)%s\n' "$D" "$R"; break; }
      printf '    %-16s %s\n' "$(basename "$r" .md)" "$(awk -F': ' '/^model:/{print $2}' "$r")"
    done
    printf '\n'
    ;;

  a2a)
    AP="${A2A_PORT:-8400}"
    if ! a2a_on; then
      echo "A2A köprüsü çalışmıyor."
      echo "  kur:  bash install.sh --with-a2a --resume"
      echo "  aç :  spark up a2a"
      exit 1
    fi
    printf '\n  %sA2A köprüsü%s  ·  roller protokolle adreslenebilir\n\n' "$B" "$R"
    printf '    kart   http://localhost:%s/.well-known/agent-card.json\n' "$AP"
    CARD="$(curl -sf --max-time 10 "http://127.0.0.1:$AP/.well-known/agent-card.json" 2>/dev/null)"
    if [[ -z "$CARD" ]]; then
      echo "    (kart okunamadı — spark logs a2a)"
    else
      printf '    sürüm  A2A %s\n\n' "$(echo "$CARD" | jq -r .protocolVersion)"
      echo "$CARD" | jq -r '.skills[] | "    \(.id)"' | while read -r l; do
        printf '  %s%s%s\n' "$G" "$l" "$R"; done
      printf '\n    örnek:\n'
      printf '      curl -s localhost:%s/agents/spark-kod/a2a/v1 \\\n' "$AP"
      printf "        -d '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"SendMessage\","
      printf "\"params\":{\"message\":{\"role\":\"ROLE_USER\",\"parts\":[{\"text\":\"...\"}]}}}'\n"
    fi
    printf '\n'
    ;;

  agents)
    shift
    AADIR="$AI_ROOT/agency-agents"; UY="$AI_ROOT/compose/uyarla.py"
    HOSTD="$HOME/.claude/agents"; CANVD="$AI_ROOT/data/canvas/agents"
    KUR="${OBSIDIAN_VAULT:-$HOME/vault}/kurallar"
    [[ -d "$AADIR" ]] || { echo "katalog yok: $AADIR"; echo "  kur: bash install.sh --with-agency --resume"; exit 1; }
    # Uyarlama her ekleme sonrası çalışır: model adı + şirket kuralları + Canvas kopyası
    uyarla(){ python3 "$UY" --host "$HOSTD" --canvas "$CANVD" --kurallar "$KUR"; }
    case "${1:-}" in
      --liste|--list)  shift; exec bash "$AADIR/scripts/install.sh" --list "${1:-agents}" --no-interactive ;;
      --sil|--remove)  shift; exec python3 "$UY" --host "$HOSTD" --canvas "$CANVD" --kurallar "$KUR" --sil "$@" ;;
      --kurulu)        printf '\n  %skurulu uzman roller%s\n\n' "$B" "$R"
                       for f in "$HOSTD"/ajans-*.md; do [ -e "$f" ] || { echo "    (yok)"; break; }
                         printf '    %-46s %s\n' "$(basename "$f" .md)" "$(awk -F": " "/^model:/{print \$2}" "$f")"; done
                       echo; exit 0 ;;
      --onerilen)      S="backend-architect,frontend-developer,software-architect,database-optimizer"
                       S="$S,devops-automator,sre-site-reliability-engineer,incident-response-commander"
                       S="$S,git-workflow-master,technical-writer,minimal-change-engineer"
                       S="$S,codebase-onboarding-engineer,api-platform-engineer,product-manager"
                       S="$S,sprint-prioritizer,meeting-notes-specialist"
                       (cd "$AADIR" && CLAUDE_CONFIG_DIR="$HOME/.claude" bash scripts/install.sh \
                          --tool claude-code --agent "$S" --no-interactive) && uyarla; exit $? ;;
      --ekle|--add)    shift; [ $# -gt 0 ] || { echo "kullanım: spark agents --ekle <slug>[,<slug>...]"; exit 1; }
                       (cd "$AADIR" && CLAUDE_CONFIG_DIR="$HOME/.claude" bash scripts/install.sh \
                          --tool claude-code --agent "$*" --no-interactive) && uyarla; exit $? ;;
      "")              # etkileşimli seçici, ardından uyarlama
                       (cd "$AADIR" && CLAUDE_CONFIG_DIR="$HOME/.claude" bash scripts/install.sh \
                          --tool claude-code) && uyarla; exit $? ;;
      *)               (cd "$AADIR" && CLAUDE_CONFIG_DIR="$HOME/.claude" bash scripts/install.sh "$@") && uyarla; exit $? ;;
    esac
    ;;

  status)
    printf '\n  %sspark-stack%s\n\n' "$B" "$R"
    repo_of() { local v="${1^^}_REPO"; echo "${!v:-?}"; }
    for s in haiku sonnet opus fable; do
      if alive "$s"; then
        printf '  %-8s %sÇALIŞIYOR%s  %s:%s  %s%s%s\n' "$s" "$G" "$R" "127.0.0.1" "$(port_of "$s")" "$D" "$(repo_of "$s")" "$R"
      else
        printf '  %-8s %skapalı%s     %s%s%s\n' "$s" "$D" "$R" "$D" "$(repo_of "$s")" "$R"
      fi
    done
    curl -sf http://127.0.0.1:4000/health/liveliness >/dev/null 2>&1 \
      && printf '  %-9s %sÇALIŞIYOR%s  http://localhost:4000\n' "kapı" "$G" "$R" \
      || printf '  %-9s %skapalı%s\n' "kapı" "$D" "$R"
    curl -sf http://127.0.0.1:3000 >/dev/null 2>&1 && printf '  %-9s %sÇALIŞIYOR%s  http://localhost:3000\n' "webui" "$G" "$R"
    if swap_on; then
      printf '  %-9s %sÇALIŞIYOR%s  katmanlar istek anında açılıyor · ayrıntı: spark swap\n' "swap" "$G" "$R"
    fi
    if canvas_on; then
      printf '  %-9s %sÇALIŞIYOR%s  http://localhost:%s/canvas\n' "canvas" "$G" "$R" "${CANVAS_PORT:-8300}"
    fi
    if a2a_on; then
      printf '  %-9s %sÇALIŞIYOR%s  http://localhost:%s/.well-known/agent-card.json\n' "a2a" "$G" "$R" "${A2A_PORT:-8400}"
    fi
    RS=$(ls -1 "$HOME/.claude/agents"/spark-*.md 2>/dev/null | wc -l)
    AS=$(ls -1 "$HOME/.claude/agents"/ajans-*.md 2>/dev/null | wc -l)
    printf '\n  Roller      : %s temel' "$RS"
    (( AS )) && printf ' + %s katalog' "$AS"
    printf '\n  Bellek      : %s\n' "$(memread)"
    printf '  Modeller    : %s\n' "$(du -sh "$AI_ROOT/models" 2>/dev/null | cut -f1)"
    printf '  Konteynerler:\n'
    $DKR ps --filter name=sk- --format '    {{.Names}}  {{.Status}}' 2>/dev/null
    echo
    ;;

  logs)  $DC logs -f --tail 100 ${2:-} ;;

  pull)
    # Model indirmeyi de konteynerle yapıyoruz — makineye python/pip kurmuyoruz
    M="${2:?kullanım: spark pull haiku|sonnet|opus|fable}"
    case "$M" in
      haiku)  REPO="$HAIKU_REPO"  ;;
      sonnet) REPO="$SONNET_REPO" ;;
      opus)   REPO="$OPUS_REPO"   ;;
      fable)  REPO="$FABLE_REPO"  ;;
      *) echo "bilinmeyen katman: $M  (haiku|sonnet|opus|fable)"; exit 1 ;;
    esac
    echo ">> $M katmanı ← $REPO"
    $DKR run --rm -e HF_TOKEN="$HF_TOKEN" -e HF_HUB_ENABLE_HF_TRANSFER=1 \
      -v "$AI_ROOT/models":/models --entrypoint bash "$VLLM_IMAGE" -c \
      "hf download '$REPO' --local-dir /models/$M" || exit 1
    echo ">> bitti: $(du -sh "$AI_ROOT/models/$M" | cut -f1)"
    ;;

  models)
    printf '\n  %-8s %-44s %s\n' "KATMAN" "MODEL" "DURUM"
    printf '  %-8s %-44s %s\n' "──────" "─────" "─────"
    for t in haiku sonnet opus fable; do
      v="${t^^}_REPO"
      printf '  %-8s %-44s %s\n' "$t" "${!v:-?}" \
        "$(alive "$t" && echo ÇALIŞIYOR || echo kapalı)"
    done
    echo
    echo "  kapıdaki adlar: $(curl -s http://127.0.0.1:4000/v1/models \
      -H "Authorization: Bearer ${LITELLM_KEY:-sk-spark}" | jq -r '[.data[].id]|join(", ")' 2>/dev/null || echo 'kapı kapalı')"
    echo
    ;;

  ask)
    Q="${2:-Merhaba, tek kelimeyle cevap ver: çalışıyor musun?}"
    curl -s --max-time 180 http://127.0.0.1:4000/v1/chat/completions \
      -H "Authorization: Bearer ${LITELLM_KEY:-sk-spark}" -H 'Content-Type: application/json' \
      -d "$(jq -n --arg q "$Q" --arg m "${3:-opus}" '{model:$m,max_tokens:200,messages:[{role:"user",content:$q}]}')" \
      | jq -r '.choices[0].message.content // .error.message'
    ;;

  update) $DC --profile daily --profile fable --profile swap --profile canvas --profile a2a --profile extras pull ;;

  *) sed -n '4,17p' "$0" | sed 's/^# \?//' ;;
esac
