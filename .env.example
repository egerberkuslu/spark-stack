# =============================================================================
#  spark-stack ayarları
#  install.sh bunu /srv/ai/compose/.env olarak kopyalar ve doldurur.
# =============================================================================

# ── zorunlu ──────────────────────────────────────────────────────────────────
HF_TOKEN=hf_xxx

# ── klasör / kapı ────────────────────────────────────────────────────────────
AI_ROOT=/srv/ai
LITELLM_KEY=sk-spark
GATEWAY_BIND=127.0.0.1          # 0.0.0.0 = diğer cihazlar da bağlanabilir

# =============================================================================
#  DÖRT KATMAN — NVIDIA + Qwen
#
#  Depo kuralı: yalnızca birinci taraf (nvidia, Qwen) ya da büyük kuantizasyoncu
#  (unsloth). Tek kişilik/deneysel depo yok.
#
#  MEM = 128 GB'nin yüzdesi. Aynı anda açık olanların toplamı 0.75'i geçmemeli.
# =============================================================================

# ── haiku · hızlı Qwen · anlık cevap, commit mesajı, dosya özeti ─────────────
# Qwen3.6-35B-A3B · 3B aktif MoE · 2.54M indirme · görsel girdi destekler
HAIKU_REPO=unsloth/Qwen3.6-35B-A3B-NVFP4
HAIKU_MEM=0.20
HAIKU_CTX=65536

# ── sonnet · hızlı NVIDIA · günlük iş, ajan döngüleri ────────────────────────
# Nemotron-3.5-Lightning-30B-A3B · 3B aktif · Mamba-MoE hibrit · 1M bağlam
# DSpark taslak modeliyle Spark'ta ölçülen ~108 tok/s — en hızlı katman.
# Bayraklar NVIDIA model kartındaki resmi DGX Spark reçetesinden.
SONNET_REPO=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4
SONNET_DRAFT=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4-DSpark
SONNET_MEM=0.18
SONNET_CTX=131072

# ── opus · Qwen kalite · ciddi kod, ajan işleri (VARSAYILAN) ─────────────────
# Qwen3.8-27B · yoğun 27B · 1.01M indirme · ajan araçlarına "developer role"
# Dense olduğu için MTP spekülatif decode şart (compose'da açık), yoksa ~12 tok/s.
OPUS_REPO=unsloth/Qwen3.8-27B-NVFP4
OPUS_MEM=0.20
OPUS_CTX=131072

# ── fable · NVIDIA ağır · en zor işler, TEK BAŞINA çalışır ───────────────────
# Nemotron-3-Super-120B-A12B · 12B aktif · NVFP4 ile ÖN EĞİTİLMİŞ · MTP dahili
FABLE_REPO=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4
FABLE_MEM=0.82
FABLE_CTX=65536

# ── imaj ─────────────────────────────────────────────────────────────────────
VLLM_IMAGE=ghcr.io/aeon-7/aeon-vllm-ultimate:latest

# ── sm_121 (GB10) zorunlu ayarları ───────────────────────────────────────────
# NVFP4 stok CUTLASS kernelleriyle sessizce bozuk çıktı üretir. Marlin önler.
VLLM_NVFP4_GEMM_BACKEND=marlin
VLLM_USE_FLASHINFER_MOE_FP4=0

# ── indirme ──────────────────────────────────────────────────────────────────
HF_WORKERS=16                   # 1 Gbit+ hat için; kararsız hatta 4-8

# ── llama-swap (isteğe bağlı, --with-swap ile kurulur) ───────────────────────
#  Katmanı istek anında açar, çakışanı kapatır, boştayı düşürür.
LLAMASWAP_TAG=unified-cuda13    # GB10/aarch64 yayınlanan etiket; "latest" yok
SWAP_BIND=127.0.0.1             # yalnız makineye açık; llama-swap'te kimlik doğrulama YOK
SWAP_TTL=1800                   # bir katman kaç saniye boşta kalınca düşsün
# SWAP_TTL_HAIKU=3600           # katman başına ayrı süre vermek istersen
# SWAP_TTL_FABLE=900
SWAP_HEALTH_TIMEOUT=2100        # ilk açılışta GPU çekirdeği derlenir; cömert bırak
SWAP_UNLOAD_TIMEOUT=60          # durdurmanın bitmesini bekleme payı
DOCKER_CLI_VERSION=28.5.1       # konteynere bağlanan statik docker CLI sürümü
# DOCKER_GID=                   # install.sh host'un docker grup kimliğini yazar

# ── Obsidian vault (isteğe bağlı, --with-wiki ile kurulur) ───────────────────
OBSIDIAN_VAULT=

# =============================================================================
#  ALTERNATİFLER (bir satırı değiştir, spark pull <katman>, spark up daily)
#    haiku   unsloth/Qwen3.6-35B-A3B-NVFP4-Fast     (22B, daha küçük)
#    opus    unsloth/Qwen3.6-27B-NVFP4              (3.87M indirme, MTP'li)
#    opus    RedHatAI/Qwen3-Coder-Next-NVFP4        (kod-özel MoE, Apache 2.0)
#    fable   unsloth/Qwen3.5-122B-A10B-NVFP4        (10B aktif)
#    görsel  unsloth/gemma-4-E4B-it-NVFP4           (7 GB, multimodal)
# =============================================================================
