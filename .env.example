# =============================================================================
#  spark-stack ayarları
#  install.sh bunu /srv/ai/compose/.env olarak kopyalar ve doldurur.
# =============================================================================

# ── zorunlu ──────────────────────────────────────────────────────────────────
HF_TOKEN=hf_xxx

# ── klasör / kapı ────────────────────────────────────────────────────────────
AI_ROOT=/srv/ai
LITELLM_KEY=sk-spark
GATEWAY_BIND=127.0.0.1          # 0.0.0.0 = diğer cihazlar da bağlanabilir

# =============================================================================
#  DÖRT KATMAN: NVIDIA + Qwen
#
#  Depo kuralı: yalnızca birinci taraf (nvidia, Qwen) ya da büyük kuantizasyoncu
#  (unsloth). Tek kişilik/deneysel depo yok.
#
#  MEM = 128 GB'nin yüzdesi. Aynı anda açık olanların toplamı 0.75'i geçmemeli.
# =============================================================================

# ── haiku · hızlı Qwen · anlık cevap, commit mesajı, dosya özeti ─────────────
# Qwen3.6-35B-A3B · 3B aktif MoE · 2.54M indirme · görsel girdi destekler
HAIKU_REPO=unsloth/Qwen3.6-35B-A3B-NVFP4
HAIKU_MEM=0.20
HAIKU_CTX=65536

# ── sonnet · hızlı NVIDIA · günlük iş, ajan döngüleri ────────────────────────
# Nemotron-3.5-Lightning-30B-A3B · 3B aktif · Mamba-MoE hibrit · 1M bağlam
# DSpark taslak modeliyle Spark'ta ölçülen ~108 tok/s, en hızlı katman.
# Bayraklar NVIDIA model kartındaki resmi DGX Spark reçetesinden.
SONNET_REPO=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4
SONNET_DRAFT=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4-DSpark
SONNET_MEM=0.18
SONNET_CTX=131072

# ── opus · Qwen kalite · ciddi kod, ajan işleri (VARSAYILAN) ─────────────────
# Qwen3.8-27B · yoğun 27B · 1.01M indirme · ajan araçlarına "developer role"
# Dense olduğu için MTP spekülatif decode şart (compose'da açık), yoksa ~12 tok/s.
OPUS_REPO=unsloth/Qwen3.8-27B-NVFP4
OPUS_MEM=0.20
OPUS_CTX=131072

# ── fable · en zor işler, TEK BAŞINA çalışır ─────────────────────────────────
# Qwen3.8-Flash-Next NVFP4 · 125B toplam, 6B aktif · çok kipli (görsel + video)
# Hibrit dikkat (Gated DeltaNet + Qwen Sparse Attention) · 262K bağlam, 1M'e çıkar
#
# Checkpoint 133 GB ama hepsi bellekte durmuyor: 51 GB'lık n-gram gömme tablosu
# (PLE) saf bir arama tablosu, bir token yalnız 16 satırına dokunuyor. NVMe'den
# mmap ile sunulunca yerleşik ağırlık ~75 GB'a iniyor ve kalan havuz KV cache'e
# gidiyor. Bu yetenek upstream vLLM'de YOK; FABLE_IMAGE yamalı yapıyı gösterir.
# Reçetenin ölçümü: ~34 tok/s (bu düzen), hazırlık yapılırsa ~37. Yükleme ~13 dk.
# Disk: checkpoint 133 GB + çalışma payı, toplam ~140 GB boş yer ister.
FABLE_REPO=nvidia/Qwen3.8-Flash-Next-NVFP4
FABLE_MEM=0.80
FABLE_CTX=262144
FABLE_SEQS=6
# Diskte 133 GB, bellekte bu kadar: kurulum bellek uyarısını buna göre verir
FABLE_RESIDENT_GB=76

# PLE ayarı: WORKERS okuma iş parçacığı, MADVISE sayfa önbellek stratejisi.
# PREWARM=1 tabloyu açılışta ısıtır (yükleme uzar, ilk istek hızlanır).
FABLE_PLE_WORKERS=32
FABLE_PLE_MADVISE=random
FABLE_PLE_PREWARM=0

# fable imajı: resmî vLLM önizlemesi + PLE yaması. install.sh bunu yerel kurar.
# Kaynak: github.com/blazux/qwen3.8-Flash-DGX (Apache-2.0)
FABLE_IMAGE=qwen38-flash-dgx:latest

# ── imaj ─────────────────────────────────────────────────────────────────────
VLLM_IMAGE=ghcr.io/aeon-7/aeon-vllm-ultimate:latest

# ── sm_121 (GB10) zorunlu ayarları ───────────────────────────────────────────
# NVFP4 stok CUTLASS kernelleriyle sessizce bozuk çıktı üretir. Marlin önler.
VLLM_NVFP4_GEMM_BACKEND=marlin
VLLM_USE_FLASHINFER_MOE_FP4=0

# ── indirme ──────────────────────────────────────────────────────────────────
HF_WORKERS=16                   # 1 Gbit+ hat için; kararsız hatta 4-8

# ── llama-swap (isteğe bağlı, --with-swap ile kurulur) ───────────────────────
#  Katmanı istek anında açar, çakışanı kapatır, boştayı düşürür.
LLAMASWAP_TAG=unified-cuda13    # GB10/aarch64 yayınlanan etiket; "latest" yok
SWAP_BIND=127.0.0.1             # yalnız makineye açık; llama-swap'te kimlik doğrulama YOK
SWAP_PORT=8081                  # 8080 DEĞİL: NemoClaw gateway o portu kullanıyor
SWAP_TTL=1800                   # bir katman kaç saniye boşta kalınca düşsün
# SWAP_TTL_HAIKU=3600           # katman başına ayrı süre vermek istersen
# SWAP_TTL_FABLE=900
SWAP_HEALTH_TIMEOUT=2100        # ilk açılışta GPU çekirdeği derlenir; cömert bırak
SWAP_UNLOAD_TIMEOUT=60          # durdurmanın bitmesini bekleme payı
DOCKER_CLI_VERSION=28.5.1       # konteynere bağlanan statik docker CLI sürümü
# DOCKER_GID=                   # install.sh host'un docker grup kimliğini yazar

# ── Agent Canvas (isteğe bağlı, --with-canvas ile kurulur) ───────────────────
#  Ajan kontrol merkezi: konuşmalar, otomasyonlar, dosyalar, terminal.
CANVAS_TAG=1.19.0               # arm64 yayınlanıyor; "latest" yerine sürüm sabitle
CANVAS_PORT=8300                # kendi portu 8000 ama onu sonnet kullanıyor
CANVAS_BIND=127.0.0.1           # ağa açarsan CANVAS_KEY'i mutlaka ayarla
CANVAS_PROJECTS=                # ajanın göreceği tek klasör (install.sh ~/projects yazar)
CANVAS_MODEL=opus               # "spark canvas" çıktısında önerilen katman
CANVAS_TELEMETRY_OFF=1

# ── ekstralar ────────────────────────────────────────────────────────────────
WEBUI_BIND=127.0.0.1            # Open WebUI de varsayılan olarak yalnız makinede
# CANVAS_UID= / CANVAS_GID=     # install.sh senin kimliğini yazar (bind mount izinleri)
# CANVAS_KEY= / OH_SECRET_KEY=  # install.sh bir kez üretir; OH_SECRET_KEY kaybolursa
#                                 kayıtlı kimlik bilgileri okunamaz hale gelir

# ── A2A köprüsü (isteğe bağlı, --with-a2a ile kurulur) ───────────────────────
#  Rolleri Agent2Agent protokolüyle dışarı açar: keşif
#  /.well-known/agent-card.json, gövde JSON-RPC 2.0.
A2A_PORT=8400
A2A_BIND=127.0.0.1             # başka makineden çağıracaksan 0.0.0.0 yap
A2A_BASE_URL=http://localhost:8400   # kartta yazan adres; ağa açarsan güncelle
# A2A_MAX_TOKENS=4096
# A2A_TIMEOUT=900

# ── Obsidian vault (isteğe bağlı, --with-wiki ile kurulur) ───────────────────
OBSIDIAN_VAULT=

# =============================================================================
#  ALTERNATİFLER (bir satırı değiştir, spark pull <katman>, spark up daily)
#    haiku   unsloth/Qwen3.6-35B-A3B-NVFP4-Fast     (22B, daha küçük)
#    opus    unsloth/Qwen3.6-27B-NVFP4              (3.87M indirme, MTP'li)
#    opus    RedHatAI/Qwen3-Coder-Next-NVFP4        (kod-özel MoE, Apache 2.0)
#    görsel  unsloth/gemma-4-E4B-it-NVFP4           (7 GB, multimodal)
#
#  fable için (ölçülmüş diskteki boyutlar):
#    nvidia/Qwen3.8-Flash-Next-NVFP4  133 GB → bellekte ~75 GB · YAMALI imaj ister · ~34 tok/s
#    RadixArk/Qwen3.8-Flash-Next-NVFP4  135 GB → aynı model, aynı yama, alternatif kaynak
#    nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4  80 GB · STOK vLLM · ~20 tok/s
#    unsloth/Qwen3.5-122B-A10B-NVFP4  79 GB · STOK vLLM · SWE-Bench'te güçlü
#  Stok vLLM'e dönersen FABLE_IMAGE satırını sil ve FABLE_MEM=0.82, FABLE_CTX=65536 yap.
# =============================================================================
